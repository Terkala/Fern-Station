# VR Pod Localization

vr-pod-name = VR Pod
vr-pod-desc = A virtual reality pod that allows players to access tutorials. Lock yourself inside and select a tutorial to begin.

# UI Strings
vr-pod-window-title = VR Pod - Tutorial Selection
vr-pod-window-select-tutorial = Select a Tutorial
vr-pod-window-start-button = Start Tutorial

# Status Strings
vr-pod-status-locked = Locked: { $locked }
vr-pod-status-powered = Powered: { $powered }
vr-pod-status-battery = Battery: { $battery }
vr-pod-status-player-inside = Player Inside: { $inside }
vr-pod-status-yes = Yes
vr-pod-status-no = No

# Error Messages
vr-pod-must-be-inside = You must be inside the VR Pod to start a tutorial.
vr-pod-must-be-locked = The VR Pod must be locked before starting a tutorial.
vr-pod-no-tutorial-selected = Please select a tutorial first.
vr-pod-tutorial-active = A tutorial is already active in this pod.
vr-pod-no-power = The VR Pod has no power and the battery is depleted.
vr-pod-already-completed-this-session = You have already completed a tutorial this session.
vr-pod-map-load-failed = Failed to load tutorial map. Please contact an administrator.
vr-pod-no-grid = Tutorial map has no valid grid.

# Success Messages
vr-pod-tutorial-started = Tutorial started! You have 5 minutes to complete it.
vr-pod-tutorial-ended = Tutorial completed successfully!
vr-pod-tutorial-ended-emergency = Tutorial ended due to pod failure or power loss.


